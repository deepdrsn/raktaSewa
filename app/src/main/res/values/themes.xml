<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme using MaterialComponents -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>

        <!-- Customize your theme here -->
        <item name="android:windowBackground">@color/gray_light</item>
    </style>

    <!-- Theme with no action bar for activities that use a Toolbar -->
    <style name="AppTheme.NoActionBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- For toolbar overlay -->
    <style name="ThemeOverlay.AppCompat.Dark.ActionBar" parent="">
        <item name="android:textColorPrimary">@android:color/white</item>
    </style>
</resources>