<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.raktasewa">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Landing Activity -->
        <activity
            android:name=".LandingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ChooseRoleActivity"
            android:exported="true" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true" />

        <activity
            android:name=".ui.register.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.register.RegisterSeekerActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false"
            android:parentActivityName=".LandingActivity" />

        <activity
            android:name=".ui.CreateRequestActivity"
            android:exported="false"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.ViewRequestsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.DonorListActivity"
            android:exported="false"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.DashboardActivity" />

        <activity
            android:name=".ui.ManageRequestsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".ui.ProfileActivity" />

        <activity
            android:name=".ui.EditProfileActivity"
            android:exported="false"
            android:parentActivityName=".ui.ProfileActivity" />

        <activity
            android:name=".ui.AcceptedRequestsActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar"
            android:parentActivityName=".ui.ProfileActivity" />

    </application>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

</manifest>